     {
      "path": "content",
      "operator": "contains",
      "value": "\"debug\": false"
     },
     {
      "path": "content",
      "operator": "contains",
      "value": "\"name\": \"demo-service\""
     },
     {
      "path": "content",
      "operator": "contains",
      "value": "\"port\": 8080"
     },
     {
      "path": "content",
      "operator": "contains",
