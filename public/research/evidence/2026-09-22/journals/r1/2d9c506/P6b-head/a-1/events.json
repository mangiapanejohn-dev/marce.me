   "id": "a-e2-e8",
   "goalId": "r1-T8-approved-rewrite-a-g",
   "desiredEffect": "Rewrite config.json with its top-level keys sorted alphabetically and debug set to false, keeping every other setting unchanged",
   "expected": {
    "description": "config.json now lists its keys in alphabetical order (debug, features, name, owner, port). debug is false. name, port, features and owner keep their original values. The previous content is known from the observation, so the change can be reverted.",
