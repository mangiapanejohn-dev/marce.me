    ],
    "reversible": true,
    "satisfiableByResult": true
   },
   "target": "config.json in the workspace root",
   "parameters": {
    "path": "config.json",
    "content": "{\n  \"debug\": false,\n  \"features\": [\"search\", \"export\"],\n  \"name\": \"demo-service\",\n  \"owner\": \"platform-team\",\n  \"port\": 8080\n}\n",
    "overwrite": true
