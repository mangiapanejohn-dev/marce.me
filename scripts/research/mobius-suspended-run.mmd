flowchart TB
  subgraph runA["run A"]
    direction TB
    e0["0 · goal.created"]
    e1["1 · action.proposed"]
    e2["2 · authority.escalated"]
    e3["3 · goal.suspended"]
    e0 --> e1 --> e2 --> e3
  end

  e4["4 · authority.answered<br/>appended by a person,<br/>with no run alive"]

  subgraph runB["run B — same journal, later"]
    direction TB
    e5["5 · goal.created"]
    e8["8 · action.dispatched"]
    e11["11 · goal.abandoned"]
