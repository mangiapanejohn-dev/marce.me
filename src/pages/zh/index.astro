---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import ResearchFeed from "@/components/ResearchFeed.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";

const posts = await getCollection("blog", ({ data }) => data.lang !== "zh");

const sortedPosts = getSortedPosts(posts);
// 博客 tab 就是博客：研究有自己的 tab。拆开之前，两篇 MØBIUS 压在最上面，把其余文章挤出了首页。
const blogPosts = sortedPosts.filter(
  ({ data }) => !data.featured && data.category !== "research"
);

const featuredProjects = [
  {
    name: "MØBIUS",
    tagline: "一个实验性的 agent runtime —— 模型之外的那部分。",
    img: "/mobius-card.svg",
    href: "/zh/mobius",
  },
  {
    name: "Offmap-X",
    tagline: "黑客松基础设施 —— 以及跑在它上面的那场黑客松。",
    img: "/offmap-chengdu.webp",
    href: "/zh/posts/offmap-we-actually-ran-the-thing",
  },
  {
    name: "QuotaLens",
    tagline: "menu bar 里的一枚 Claude / Codex 额度表。",
    img: "/quotalens-hero.png",
    href: "/zh/posts/quotalens-small-tool",
  },
];
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">
    <section id="hero" class="pt-6 pb-4">
      <div class="flex flex-col sm:flex-row items-start gap-4">
        <a href="/zh/about" class="block mx-auto sm:mx-0 group">
          <img
            src="/marce.jpg"
            alt={SITE.author}
            width="160"
            height="160"
            class="w-40 h-40 rounded-full object-cover flex-shrink-0 transition-all duration-300 group-hover:scale-105 group-hover:shadow-xl"
          />
        </a>
        <div class="flex-1 text-center sm:text-left">
          <div class="flex items-center gap-2 justify-center sm:justify-start">
            <h1 class="typing-effect my-2 text-2xl font-bold sm:my-4 sm:text-3xl">@marcE</h1>
            <a target="_blank" href="/rss.xml" class="inline-block" aria-label="RSS 订阅" title="RSS 订阅">
              <IconRss width={20} height={20} class="scale-125 stroke-accent stroke-3" />
              <span class="sr-only">RSS 订阅</span>
            </a>
          </div>
          <div class="bio-collapsed space-y-3 opacity-80" id="bio-text">
            <p>哟!!!我叫 Mark Ellington。你可以叫我 Marc,或者 BUG～。</p>
            <p>我们这种生物可以统称为 Vibe Coder ✌️,也可以理解成「硅基生命营养师」👾。</p>
            <p>我不喜欢那些繁琐的规矩,更愿意自己安排想做的事,一个人待着(我觉得这样效率很高)。</p>
            <p>大家都说我不太会聊天、是个直男,我也这么觉得 😁。无所谓,我不在意这些。我经常到处跑,去过很多地方(多到数不清),但每个地方都有很棒的回忆 🤠。</p>
            <p>因为我穿得就是简单的极客风,居然有人说我穿得像 GAY。我:「WTFREAK!? 我这穿搭不正常吗?!我怎么就 GAY 了 🤣」(我真不是 GAY,别对我有这种误会 🫥)。</p>
            <p>对了!我做的大部分东西都会传到 GitHub 上,供你 fork 和 remix ☝️。</p>
            <p>如果非要用一句话形容自己,我觉得是:一个阳光开朗的家伙,哈哈哈 ✌️</p>
            <p>#SBTI:OJBK #MBTI:INTJ #「Loser」#幽默 #好人 #Marc #……</p>
          </div>
          <button id="read-more-btn" class="text-sm text-accent hover:underline mt-1">阅读更多</button>
          <div class="mt-4 flex flex-row items-center justify-center sm:justify-start">
            <div class="flex-wrap justify-center gap-1">
              <Socials />
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="max-w-3xl mx-auto px-4">
      <hr class="border-border" aria-hidden="true" />
    </div>

    <section id="featured-projects" class="pt-12">
      <h2 class="text-2xl font-semibold tracking-wide">精选项目</h2>
      <div class="mt-5 grid gap-4 sm:grid-cols-3">
        {
          featuredProjects.map(project => (
            <a
              href={project.href}
              class="group block overflow-hidden rounded-xl border border-border bg-muted/20 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg"
            >
              <div class="aspect-[16/10] overflow-hidden">
                <img
                  src={project.img}
                  alt={project.name}
                  loading="lazy"
                  class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                />
              </div>
              <div class="p-4">
                <h3 class="font-semibold text-accent group-hover:underline">
                  {project.name}
                </h3>
                <p class="mt-1 text-sm opacity-80">{project.tagline}</p>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <section id="recent" class="pt-12 pb-6">
      <div class="mb-4 flex items-center gap-5 border-b border-border pb-1">
        <button
          type="button"
          class="feed-tab text-xl font-semibold tracking-wide"
          data-panel="blog"
          aria-selected="true"
        >
          博客
        </button>
        <button
          type="button"
          class="feed-tab text-xl font-semibold tracking-wide"
          data-panel="research"
          aria-selected="false"
        >
          研究动态
        </button>
      </div>

      <div id="panel-blog">
        <ul>
          {
            blogPosts.map(
              (data, index) =>
                index < SITE.postPerIndex && <Card variant="h3" {...data} />
            )
          }
        </ul>
        <div class="my-8 text-center">
          <LinkButton href="/zh/posts/">
            全部文章
            <IconArrowRight class="inline-block rtl:-rotate-180" />
          </LinkButton>
        </div>
      </div>

      <div id="panel-research" hidden>
        <ResearchFeed limit={4} showMore />
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .bio-collapsed {
    max-height: 7.5rem;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent);
    mask-image: linear-gradient(to bottom, #000 55%, transparent);
  }
  .typing-effect {
    display: inline-block;
    width: 6ch;
    overflow: hidden;
    white-space: nowrap;
    border-inline-end: 2px solid currentColor;
    animation:
      typing 2.5s steps(6) infinite alternate,
      caret 0.7s step-end infinite;
  }
  @keyframes typing {
    0%, 15% { width: 0; }
    60%, 100% { width: 6ch; }
  }
  @keyframes caret {
    50% { border-color: transparent; }
  }
  @media (prefers-reduced-motion: reduce) {
    .typing-effect {
      width: 6ch;
      animation: none;
      border-inline-end: none;
    }
  }

  /* 博客 / 研究动态 两个 tab。未选中的那个读起来像一个可点的标题，
     所以这一行仍然是它替代掉的那个小节标题。 */
  .feed-tab {
    color: var(--foreground);
    opacity: 0.4;
    padding-bottom: 0.35rem;
    margin-bottom: -0.3rem;
    border-bottom: 2px solid transparent;
    transition: opacity 0.15s;
  }
  .feed-tab:hover {
    opacity: 0.7;
  }
  .feed-tab[aria-selected="true"] {
    opacity: 1;
    border-bottom-color: var(--accent);
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const bioText = document.getElementById("bio-text");
    const readMoreBtn = document.getElementById("read-more-btn");

    if (bioText && readMoreBtn) {
      readMoreBtn.addEventListener("click", () => {
        const isClamped = bioText.classList.contains("bio-collapsed");
        bioText.classList.toggle("bio-collapsed", !isClamped);
        readMoreBtn.textContent = isClamped ? "阅读更多" : "收起";
      });
    }

    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/zh");
    }

    // 博客 / 研究动态。两块都在 HTML 里，所以页面在这段脚本跑之前就是完整的，
    // 没有 JS 的读者看到的是博客列表，而不是空白。
    const tabs = [...document.querySelectorAll<HTMLButtonElement>(".feed-tab")];
    tabs.forEach(tab => {
      tab.addEventListener("click", () => {
        tabs.forEach(other => {
          const selected = other === tab;
          other.setAttribute("aria-selected", String(selected));
          const panel = document.getElementById(`panel-${other.dataset.panel}`);
          if (panel) panel.hidden = !selected;
        });
      });
    });
  });
</script>
