---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";
import { getCollection as getCollectionZh } from "astro:content";
import { getEntry } from "astro:content";

const postsZh = await getCollection("zh");
const sortedPosts = getSortedPosts(postsZh);
const recentPosts = sortedPosts;
---

<Layout title="首页">
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">
    <section id="hero" class="pt-6 pb-4">
      <div class="flex flex-col sm:flex-row items-start gap-4">
        <a href="/zh/about" class="block mx-auto sm:mx-0 group">
          <img
            src="/marce.jpg"
            alt={SITE.author}
            class="w-40 h-40 rounded-full object-cover flex-shrink-0 transition-all duration-300 group-hover:scale-105 group-hover:shadow-xl"
          />
        </a>
        <div class="flex-1 text-center sm:text-left">
          <div class="flex items-center gap-2 justify-center sm:justify-start">
            <h1 class="my-2 inline-block text-2xl font-bold sm:my-4 sm:text-3xl">
              {SITE.author}
            </h1>
            <a target="_blank" href="/zh/rss.xml" class="inline-block" aria-label="RSS 订阅" title="RSS 订阅">
              <IconRss width={20} height={20} class="scale-125 stroke-accent stroke-3" />
              <span class="sr-only">RSS 订阅</span>
            </a>
          </div>
          <p class="opacity-80 line-clamp-5" id="bio-text-zh">
            Yoo!!! 我叫 Mark Ellington。你可以叫我 Marc 或 BUG～。<br/><br/>
            我们这类人可以叫 Vibe Coder ✌️，也就是硅基生物营养师 👾。<br/><br/>
            我不喜欢那些繁琐的规则；我喜欢按自己的方式安排想做的事，保持独立（我觉得这样效率很高）。<br/><br/>
            大家都说我不会说话，是个直男，我也这么认为 😁。不管了，我不在意。我经常到处跑，去过很多地方（多到数不清），但每个地方都有美好的回忆 🤠。<br/><br/>
            因为我的穿搭是简单 Geek 风格，有人说我穿得 GAY。我："WTFREAK！？我穿得很正常啊！？咋就 GAY 了 🤣"（我真不是 GAY，别误会 🫥）。<br/><br/>
            哦对了！我开发的大部分东西都会上传到 GitHub 给你 fork 和 remix ☝️。<br/><br/>
            要用一句话形容自己，我觉得应该是：阳光快乐的小伙哈哈哈 ✌️<br/><br/>
            #SBTI:OJBK #MBTI:INTJ #"Loser" #Humorous #Good Guy #Marc #......
          </p>
          <button id="read-more-zh" class="text-sm text-accent hover:underline mt-1">Read more</button>
          <div class="mt-4 flex flex-row items-center justify-center sm:justify-start">
            <div class="flex-wrap justify-center gap-1">
              <Socials />
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="max-w-3xl mx-auto px-4">
      <hr class="border-border" aria-hidden="true" />
    </div>

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">最近的文章</h2>
          <ul>
            {recentPosts.map(
              (data, index) =>
                index < SITE.postPerIndex && <Card variant="h3" {...data} />
            )}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href="/zh/posts/">
        查看全部
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .line-clamp-5 {
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const bioText = document.getElementById("bio-text-zh");
    const readMoreBtn = document.getElementById("read-more-zh");

    if (bioText && readMoreBtn) {
      readMoreBtn.addEventListener("click", () => {
        const isClamped = bioText.classList.contains("line-clamp-5");
        bioText.classList.toggle("line-clamp-5", !isClamped);
        readMoreBtn.textContent = isClamped ? "Read more" : "Show less";
      });
    }
  });
</script>