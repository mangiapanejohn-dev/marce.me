---
import Layout from "@/layouts/Layout.astro";
import ProfileCard from "@/components/ProfileCard.astro";
import { SITE } from "@/config";
---

<Layout
  title={`名片 | ${SITE.title}`}
  description="Marc Ellington — Vibe Coder，做真的记得住你的 AI 工具。"
>
  <main id="card-page">
    <ProfileCard lang="zh" />
  </main>
</Layout>

<style>
  /* Deliberately chrome-free: no Header, no Footer — the card is the whole page. */
  #card-page {
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
  }
</style>
