---
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";
import fs from "node:fs";
import path from "node:path";

const version = fs
  .readFileSync(path.resolve(process.cwd(), "public/omega/VERSION"), "utf-8")
  .trim();
---

<Layout title={`ø / Omega | ${SITE.title}`} noindex={true}>
  <script is:inline>
    // 地址栏净化：无论从 /zh/omega 重定向还是编码链接 /zh/%C3%B8 进来，落地后都显示 /zh/ø
    if (location.pathname !== "/zh/ø") {
      history.replaceState(null, "", "/zh/ø" + location.search + location.hash);
    }
  </script>
  <Header />
  <Main
    pageTitle="ø / Omega"
    pageDesc="Claude Code 的共生型元认知层。"
  >
    <div class="mx-auto max-w-2xl">
      <img
        src="/omega/omega-logo.png"
        alt="ø"
        width="140"
        height="140"
        class="mx-auto my-6 rounded-2xl"
      />

      <p class="text-center italic opacity-80">
        /omega thinks with Marc. /omega-update grows the Brain. Friday keeps ø
        alive.
      </p>

      <h2 class="mt-10 text-xl font-semibold">ø 是什么？</h2>
      <p class="mt-2">
        ø 是我个人知识库的元认知层——不是总结器，也不是替我做决策的代理。它读取我第二大脑的当前与历史状态，推演多条世界线，并通过对话与我一起进化。
      </p>
      <ul class="mt-3 list-disc space-y-1 pl-6">
        <li>
          <code>/omega</code> —— 派出 7 个 subagent 组成的 council（史官、Marc
          模拟器、工程师、批判者、趋势观察者、知识架构师、裁判），推演出最优参考
          / 稳妥 / 高收益 / 失败 四条路径，再与你对话对齐。
        </li>
        <li>
          <code>/omega-update</code> —— 按明确的 Merge Plan 把达成的共识合并进知识库。旧知识只压缩归档，绝不删除。
        </li>
        <li>
          每周五 21:30 后台自动扫描，生成 Weekly Brief 并发出常驻 macOS 通知。
        </li>
        <li>
          ø 拥有自己的记忆：四个模型（marc / omega / knowledge / world）、一份知识图谱视图，以及一本记录自己误判的错题本。
        </li>
      </ul>

      <h2 class="mt-10 text-xl font-semibold">安装</h2>
      <p class="mt-2 text-sm opacity-80">
        版本 {version} · macOS 全量 · Linux 尽力（未测试）· Windows 仅核心
      </p>

      <p class="mt-4 mb-1 font-medium">macOS / Linux</p>
      <pre
        class="overflow-x-auto rounded border border-border bg-muted/30 p-3 text-sm"><code>curl -fsSL https://marcyy.me/omega/install.sh | bash</code></pre>

      <p class="mt-4 mb-1 font-medium">Windows（PowerShell，仅装 skill）</p>
      <pre
        class="overflow-x-auto rounded border border-border bg-muted/30 p-3 text-sm"><code>irm https://marcyy.me/omega/install.ps1 | iex</code></pre>

      <p class="mt-3 text-sm">
        想先看看内容？下载
        <a class="text-accent underline" href="/omega/omega.tar.gz">omega.tar.gz</a>
        /
        <a class="text-accent underline" href="/omega/omega.zip">omega.zip</a>
        ，或直接读
        <a class="text-accent underline" href="/omega/install.sh">install.sh</a>。
      </p>

      <h2 class="mt-10 text-xl font-semibold">会装什么</h2>
      <ul class="mt-2 list-disc space-y-1 pl-6 text-sm">
        <li><code>~/.claude/skills/omega</code> + <code>omega-update</code> —— 两个入口 skill</li>
        <li><code>~/.claude/agents/omega-*.md</code> —— 7 个 council subagent</li>
        <li><code>~/omega/</code> —— 脚本（周五扫描、通知、状态）、launchd 模板、README</li>
        <li>可选（macOS，安装时询问）：周五 21:30 launchd 任务、ø 品牌通知器</li>
      </ul>

      <h2 class="mt-10 text-xl font-semibold">卸载</h2>
      <pre
        class="overflow-x-auto rounded border border-border bg-muted/30 p-3 text-sm"><code>bash ~/omega/scripts/uninstall-omega-launchd.sh
rm -rf ~/.claude/skills/omega ~/.claude/skills/omega-update ~/.claude/agents/omega-*.md ~/omega</code></pre>

      <div class="mt-10 rounded border border-border p-4 text-sm opacity-90">
        <p class="font-medium">原样分享</p>
        <p class="mt-1">
          这是我个人的元认知系统，作为参考发布——<code>/omega</code> skill
          默认我的知识库结构（一个叫 “Marc Brain” 的 Obsidian
          vault，有自己的索引页和同步约定）。它能干净地装在任何地方，但要真正为你所用，请读
          <code>README-OMEGA.md</code>，把路径、模型和导航改造成你自己的大脑。无支持、无保证，欢迎反馈。
        </p>
      </div>
    </div>
  </Main>
  <Footer />
</Layout>
