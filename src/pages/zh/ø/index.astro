---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";
import fs from "node:fs";
import path from "node:path";

const version = fs
  .readFileSync(path.resolve(process.cwd(), "public/ø/VERSION"), "utf-8")
  .trim();

const cmdMac = "curl -fsSL https://marcyy.me/ø/install.sh | bash";
const cmdWin = "irm https://marcyy.me/ø/install.ps1 | iex";
const cmdUninstall =
  "rm -rf ~/.claude/skills/omega ~/.claude/skills/omega-update ~/.claude/agents/omega-*.md ~/omega";

const council = [
  ["historian", "史官", "翻出过去的决策与成败模式——让 ø 永远不忘历史。"],
  ["marc-simulator", "推演模型", "推演我按惯性会怎么做，并在模型过时时报警。"],
  ["builder", "工程师", "把任何愿景砍到一个能落地的 v0.1：步骤、文件、成本。"],
  ["critic", "批判者", "找失败路径，打碎过度复杂、空泛和伪自动化。"],
  ["trend", "趋势观察者", "看外部世界，给出保守 / 预期 / 颠覆三种情景。"],
  ["knowledge-architect", "知识架构师", "决定新认知该以什么结构长回大脑。"],
];

const loop = [
  ["01", "/omega", "council 推演，生成最优参考 / 稳妥 / 高收益 / 失败四条世界线。"],
  ["02", "对话对齐", "把我当前的思路和参考路径对齐——我可以反驳。"],
  ["03", "/omega-update", "达成的共识合并进大脑。旧知识只压缩，绝不删除。"],
  ["04", "进化", "知识库进化；下一轮在更新后的状态上重新校准。"],
];
---

<Layout title={`ø / Omega | ${SITE.title}`} noindex={true}>
  <script is:inline>
    if (location.pathname !== "/zh/ø") {
      history.replaceState(null, "", "/zh/ø" + location.search + location.hash);
    }
  </script>
  <Header />

  <main id="omega" class="mx-auto w-full max-w-3xl px-4 pb-24">
    <!-- HERO — framed print -->
    <section class="hero" aria-label="ø / Omega — 共生进化层">
      <figure class="card">
        <picture class="card-light">
          <source srcset="/ø/co-evolution-card.webp" type="image/webp" />
          <img
            src="/ø/co-evolution-card.png"
            width="1400"
            height="933"
            fetchpriority="high"
            alt="ø — CO-EVOLUTION LAYER. Where memory folds into evolution, no answer remains final. Memory → Folds → Evolves → Next Version. Evolve · Reflect · Update. V01 → ∞"
          />
        </picture>
        <picture class="card-dark" aria-hidden="true">
          <source srcset="/ø/co-evolution-card-dark.webp" type="image/webp" />
          <img src="/ø/co-evolution-card-dark.png" width="1536" height="1024" alt="" />
        </picture>
      </figure>
    </section>

    <!-- INSTALL -->
    <section class="block reveal">
      <p class="eyebrow">安装 · v{version} · macOS 全量 · Linux 尽力 · Windows 核心</p>
      <div class="cmd">
        <span class="cmd-os">macOS / Linux</span>
        <div class="cmd-row">
          <code>{cmdMac}</code>
          <button class="copy" data-copy={cmdMac} aria-label="复制安装命令">复制</button>
        </div>
      </div>
      <div class="cmd">
        <span class="cmd-os">Windows · PowerShell · 仅装 skill</span>
        <div class="cmd-row">
          <code>{cmdWin}</code>
          <button class="copy" data-copy={cmdWin} aria-label="复制安装命令">复制</button>
        </div>
      </div>
      <p class="fineprint">
        想先看看内容？读
        <a href="/ø/install.sh">install.sh</a> ·
        <a href="/ø/omega.tar.gz">omega.tar.gz</a> ·
        <a href="/ø/omega.zip">omega.zip</a>
      </p>
    </section>

    <!-- WHAT IS ø -->
    <section class="block reveal">
      <p class="eyebrow">ø 是什么</p>
      <p class="lede">
        ø 是我个人知识库的元认知层——不是总结器，也不是替我做决策的代理。它读取我第二大脑的当前与历史状态，派出一组 subagent
        组成的 council 推演多条世界线，并通过对话与我一起进化。我始终是那个做决定的人。
      </p>
    </section>

    <!-- HOW IT WORKS -->
    <section class="block reveal">
      <p class="eyebrow">它怎么运作 · 共生进化闭环</p>
      <ol class="loop">
        {loop.map(([n, name, desc]) => (
          <li class="loop-step">
            <span class="loop-n">{n}</span>
            <div>
              <p class="loop-name">{name}</p>
              <p class="loop-desc">{desc}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="loop-close"><span class="arw">↺</span>&nbsp; 每周五，它又自己重新开始。</p>

      <figure class="arch">
        <button class="arch-thumb" data-lightbox="/ø/architecture.png" aria-label="放大完整架构图">
          <img src="/ø/architecture.png" alt="ø 状态机：触发路由、周五扫描、council 推演、对话、更新闸门、知识生长" loading="lazy" />
          <span class="arch-hint">点击放大 — 完整状态机</span>
        </button>
        <figcaption>触发 → council → 对话 → 更新闸门 → 知识生长 → 重新校准。</figcaption>
      </figure>
    </section>

    <!-- COUNCIL -->
    <section class="block reveal">
      <p class="eyebrow">Council · 六个并行推演，一个裁判</p>
      <div class="council">
        {council.map(([handle, name, desc]) => (
          <div class="agent">
            <span class="agent-handle">{handle}</span>
            <p class="agent-name">{name}</p>
            <p class="agent-desc">{desc}</p>
          </div>
        ))}
      </div>
      <div class="judge">
        <span class="agent-handle">judge</span>
        <p class="agent-name">裁判</p>
        <p class="agent-desc">
          等齐六个，再给它们的世界线打分并给出裁决——最优 / 稳妥 / 高收益 / 别选。它从不自己造路线，只裁判别人的输出。
        </p>
      </div>
    </section>

    <!-- FRIDAY -->
    <section class="block reveal">
      <p class="eyebrow">Friday keeps ø alive</p>
      <p class="lede">
        每周五 21:30，后台扫描自己跑起来，写一份 Weekly Brief，发一条常驻通知。它不碰稳定知识库——只是等着。等我准备好，运行
        <code class="inline">/omega resume weekly</code>，对话就从扫描停下的地方接上。
      </p>
    </section>

    <!-- WHAT GETS INSTALLED -->
    <section class="block reveal">
      <p class="eyebrow">会装什么</p>
      <ul class="files">
        <li><code>~/.claude/skills/omega</code> + <code>omega-update</code><i class="dots"></i><span>两个入口 skill</span></li>
        <li><code>~/.claude/agents/omega-*.md</code><i class="dots"></i><span>7 个 council subagent</span></li>
        <li><code>~/omega/</code><i class="dots"></i><span>脚本、launchd 模板、README</span></li>
        <li>可选 · macOS<i class="dots"></i><span>周五 launchd 任务、ø 品牌通知器</span></li>
      </ul>
    </section>

    <!-- UNINSTALL -->
    <section class="block reveal">
      <p class="eyebrow">卸载</p>
      <div class="cmd">
        <div class="cmd-row">
          <code>{cmdUninstall}</code>
          <button class="copy" data-copy={cmdUninstall} aria-label="复制卸载命令">复制</button>
        </div>
      </div>
    </section>

    <!-- AS-IS -->
    <section class="asis reveal">
      <p class="eyebrow">原样分享</p>
      <p>
        这是我个人的元认知系统，作为参考发布。<code class="inline">/omega</code> skill 默认我的知识库结构——一个叫
        “Marc Brain” 的 Obsidian vault，有自己的索引页和同步约定。它能干净地装在任何地方，但要真正为你所用，请读
        <code class="inline">README-OMEGA.md</code>，把路径、模型和导航改造成你自己的大脑。无支持、无保证，欢迎反馈。
      </p>
    </section>
  </main>

  <div id="lightbox" class="lightbox">
    <button class="lightbox-close" aria-label="关闭">✕&nbsp; 关闭</button>
    <img id="lightbox-img" src="" alt="ø 架构图，完整尺寸" />
  </div>

  <Footer />
</Layout>

<script is:inline>
  // Copy buttons
  document.querySelectorAll(".copy").forEach(btn => {
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(btn.getAttribute("data-copy"));
        const prev = btn.textContent;
        btn.textContent = "已复制";
        btn.classList.add("is-copied");
        setTimeout(() => {
          btn.textContent = prev;
          btn.classList.remove("is-copied");
        }, 1500);
      } catch (e) {
        /* clipboard blocked — no-op */
      }
    });
  });

  // Lightbox for the architecture diagram
  const lb = document.getElementById("lightbox");
  const lbImg = document.getElementById("lightbox-img");
  const openLb = src => {
    lbImg.src = src;
    lb.classList.add("is-open");
    document.body.style.overflow = "hidden";
  };
  const closeLb = () => {
    lb.classList.remove("is-open");
    document.body.style.overflow = "";
    setTimeout(() => {
      if (!lb.classList.contains("is-open")) lbImg.src = "";
    }, 300);
  };
  document.querySelectorAll("[data-lightbox]").forEach(el => {
    el.addEventListener("click", () => openLb(el.getAttribute("data-lightbox")));
  });
  lb.addEventListener("click", e => {
    if (e.target === lb || e.target.classList.contains("lightbox-close")) closeLb();
  });
  document.addEventListener("keydown", e => {
    if (e.key === "Escape" && lb.classList.contains("is-open")) closeLb();
  });

  // Scroll-reveal — each section fades up once
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const reveals = document.querySelectorAll(".reveal");
  if (reduce || !("IntersectionObserver" in window)) {
    reveals.forEach(el => el.classList.add("in"));
  } else {
    const io = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            e.target.classList.add("in");
            obs.unobserve(e.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
    );
    reveals.forEach(el => io.observe(el));
  }
</script>

<style>
  #omega {
    --ink: var(--foreground);
    --line: color-mix(in srgb, var(--foreground) 22%, transparent);
    --faint: color-mix(in srgb, var(--foreground) 55%, transparent);
    font-variant-ligatures: none;
  }

  /* ---------- MOTION ---------- */
  .reveal {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.7s ease,
      transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
    will-change: opacity, transform;
  }
  .reveal.in {
    opacity: 1;
    transform: none;
  }
  .is-hero {
    transition-duration: 0.9s;
  }

  /* ---------- HERO — framed print ---------- */
  .hero {
    margin: 2.25rem 0 1rem;
  }
  .card {
    margin: 0;
    border-radius: clamp(0.75rem, 2.5vw, 1.25rem);
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.04),
      0 18px 50px -24px rgba(0, 0, 0, 0.35);
  }
  .card img {
    display: block;
    width: 100%;
    height: auto;
  }
  .card-dark {
    display: none;
  }
  :global(html[data-theme="dark"]) .card-light {
    display: none;
  }
  :global(html[data-theme="dark"]) .card-dark {
    display: block;
  }
  :global(html[data-theme="dark"]) .card {
    border-color: color-mix(in srgb, var(--foreground) 14%, transparent);
    box-shadow: 0 24px 70px -28px rgba(0, 0, 0, 0.7);
  }

  .dots {
    flex: 1;
    align-self: center;
    height: 3px;
    min-width: 1rem;
    background-image: radial-gradient(circle at center, var(--faint) 0.9px, transparent 1.1px);
    background-size: 5px 3px;
    background-repeat: repeat-x;
    background-position: center;
    opacity: 0.7;
  }
  .arw {
    color: var(--ink);
  }

  /* ---------- SECTIONS ---------- */
  .block {
    margin-top: clamp(2.5rem, 8vw, 4.5rem);
  }
  .eyebrow {
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--faint);
    margin-bottom: 1.1rem;
  }
  .lede {
    font-size: 0.95rem;
    line-height: 1.75;
    color: color-mix(in srgb, var(--foreground) 90%, transparent);
  }
  code.inline {
    font-size: 0.85em;
    padding: 0.05em 0.35em;
    border: 1px solid var(--line);
    border-radius: 0.3rem;
  }

  /* ---------- COMMAND BLOCKS ---------- */
  .cmd {
    margin-bottom: 0.9rem;
  }
  .cmd-os {
    display: block;
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
    margin-bottom: 0.4rem;
  }
  .cmd-row {
    display: flex;
    align-items: stretch;
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    overflow: hidden;
    transition: border-color 0.2s ease;
  }
  .cmd-row:hover,
  .cmd-row:focus-within {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
  }
  .cmd-row code {
    flex: 1;
    padding: 0.85rem 1rem;
    font-size: 0.8rem;
    overflow-x: auto;
    white-space: nowrap;
    display: flex;
    align-items: center;
  }
  .copy {
    flex-shrink: 0;
    padding: 0 1.1rem;
    border-left: 1px solid var(--line);
    background: color-mix(in srgb, var(--muted) 22%, var(--background));
    color: var(--faint);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 0.15s, background 0.15s, transform 0.1s ease;
  }
  .copy:hover {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, var(--background));
  }
  .copy:active {
    transform: scale(0.94);
  }
  .copy.is-copied {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, var(--background));
  }
  .fineprint {
    margin-top: 0.9rem;
    font-size: 0.78rem;
    color: var(--faint);
  }
  .fineprint a {
    color: var(--accent);
    text-underline-offset: 3px;
  }

  /* ---------- LOOP ---------- */
  .loop {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0;
  }
  .loop-step {
    display: flex;
    gap: 1.1rem;
    padding: 1.1rem 0;
    border-top: 1px solid var(--line);
  }
  .loop-step:last-child {
    border-bottom: 1px solid var(--line);
  }
  .loop-n {
    font-size: 0.7rem;
    color: var(--faint);
    padding-top: 0.2rem;
    letter-spacing: 0.05em;
  }
  .loop-name {
    font-size: 0.95rem;
    font-weight: 500;
  }
  .loop-desc {
    margin-top: 0.25rem;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--faint);
  }
  .loop-close {
    margin-top: 1rem;
    font-size: 0.82rem;
    color: var(--faint);
  }

  /* ---------- ARCHITECTURE ---------- */
  .arch {
    margin: 1.75rem 0 0;
  }
  .arch-thumb {
    display: block;
    width: 100%;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    overflow: hidden;
    cursor: zoom-in;
    position: relative;
    background: #0f1116;
  }
  .arch-thumb img {
    width: 100%;
    height: 260px;
    object-fit: cover;
    object-position: top center;
    display: block;
    opacity: 0.92;
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1), opacity 0.3s ease;
  }
  .arch-thumb:hover img {
    transform: scale(1.035);
    opacity: 1;
  }
  .arch-hint {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    padding: 2.5rem 1rem 0.9rem;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #cfd3dc;
    background: linear-gradient(to top, rgba(15, 17, 22, 0.95), transparent);
    text-align: center;
  }
  .arch figcaption {
    margin-top: 0.7rem;
    font-size: 0.75rem;
    color: var(--faint);
    text-align: center;
  }

  /* ---------- COUNCIL ---------- */
  .council {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    overflow: hidden;
  }
  .agent {
    padding: 1.1rem 1.15rem;
    background: var(--background);
    transition: background 0.2s ease;
  }
  .agent:hover {
    background: color-mix(in srgb, var(--muted) 20%, var(--background));
  }
  .agent-handle {
    font-size: 0.66rem;
    letter-spacing: 0.05em;
    color: var(--accent);
  }
  .agent-name {
    margin-top: 0.3rem;
    font-size: 0.92rem;
    font-weight: 500;
  }
  .agent-desc {
    margin-top: 0.35rem;
    font-size: 0.8rem;
    line-height: 1.55;
    color: var(--faint);
  }
  .judge {
    margin-top: 1px;
    padding: 1.2rem 1.15rem;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--muted) 16%, var(--background));
  }
  .judge .agent-desc {
    max-width: 46ch;
  }

  /* ---------- FILES ---------- */
  .files {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.65rem;
  }
  .files li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
  }
  .files code {
    font-size: 0.8rem;
  }
  .files span {
    color: var(--faint);
    white-space: nowrap;
  }

  /* ---------- AS-IS ---------- */
  .asis {
    margin-top: clamp(2.5rem, 8vw, 4.5rem);
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--muted) 12%, var(--background));
    font-size: 0.85rem;
    line-height: 1.7;
    color: var(--faint);
  }
  .asis .eyebrow {
    margin-bottom: 0.7rem;
  }

  /* ---------- LIGHTBOX ---------- */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 999;
    background: rgba(10, 11, 15, 0.94);
    overflow: auto;
    padding: 3.5rem 1rem 3rem;
    text-align: center;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.28s ease, visibility 0.28s ease;
  }
  .lightbox.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
  .lightbox img {
    max-width: min(920px, 100%);
    height: auto;
    margin: 0 auto;
    border-radius: 0.5rem;
    transform: scale(0.985);
    transition: transform 0.34s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .lightbox.is-open img {
    transform: none;
  }
  .lightbox-close {
    transition: background 0.15s ease;
  }
  .lightbox-close:hover {
    background: rgba(255, 255, 255, 0.22);
  }
  .lightbox-close {
    position: fixed;
    top: 1rem;
    right: 1rem;
    padding: 0.5rem 0.9rem;
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 0.4rem;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
  }

  /* ---------- RESPONSIVE ---------- */
  @media (min-width: 640px) {
    .arch-thumb img {
      height: 320px;
    }
  }
  @media (max-width: 560px) {
    .council {
      grid-template-columns: 1fr;
    }
    .files li {
      flex-wrap: wrap;
    }
    .files span {
      white-space: normal;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal,
    .is-hero,
    .card img,
    .arch-thumb img,
    .copy,
    .cmd-row,
    .agent,
    .lightbox,
    .lightbox img {
      transition: none !important;
    }
    .reveal {
      opacity: 1;
      transform: none;
    }
    .arch-thumb:hover img {
      transform: none;
    }
  }
</style>
