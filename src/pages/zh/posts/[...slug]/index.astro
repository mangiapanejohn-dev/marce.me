---
import { getCollection } from "astro:content";
import PostDetails from "@/layouts/PostDetails.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { getPath } from "@/utils/getPath";
import { getTranslationKey } from "@/i18n/utils";

export async function getStaticPaths() {
  const enPosts = await getCollection(
    "blog",
    ({ data }) => !data.draft && data.lang !== "zh"
  );
  const zhPosts = await getCollection(
    "blog",
    ({ data }) => !data.draft && data.lang === "zh"
  );

  return enPosts.map(enPost => {
    const key = getTranslationKey(enPost.id);
    const zh = zhPosts.find(p => getTranslationKey(p.id) === key);
    const slug = getPath(enPost.id, enPost.filePath, false);
    return {
      params: { slug },
      // Show the Chinese version if it exists, else fall back to English.
      props: { post: zh ?? enPost, showFallbackNotice: !zh, slug },
    };
  });
}

const { post, showFallbackNotice, slug } = Astro.props;

const posts = await getCollection(
  "blog",
  ({ data }) => !data.draft && data.lang !== "zh"
);
const sortedPosts = getSortedPosts(posts);
---

<PostDetails
  post={post}
  posts={sortedPosts}
  slug={slug}
  showFallbackNotice={showFallbackNotice}
/>
