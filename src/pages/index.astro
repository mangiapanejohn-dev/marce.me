---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import ResearchFeed from "@/components/ResearchFeed.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";

const posts = await getCollection("blog", ({ data }) => data.lang !== "zh");

const sortedPosts = getSortedPosts(posts);
// The Blog tab is the blog: research has its own tab, and before this split the two MØBIUS posts
// sat on top of the list and pushed everything else off the homepage.
const blogPosts = sortedPosts.filter(
  ({ data }) =>
    !data.featured && (data.category !== "research" || data.showInBlog)
);
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">
    <section id="hero" class="pt-6 pb-4">
      <div class="flex flex-col sm:flex-row items-start gap-4">
        <a href="/about" class="block mx-auto sm:mx-0 group">
          <picture>
            <source srcset="/marce-avatar.webp" type="image/webp" />
            <img
              src="/marce-avatar.png"
              alt="Marc Ellington"
              width="160"
              height="160"
              fetchpriority="high"
              class="w-40 h-40 rounded-full object-cover flex-shrink-0 transition-all duration-300 group-hover:scale-105 group-hover:shadow-xl"
            />
          </picture>
        </a>
        <div class="flex-1 text-center sm:text-left">
          <div class="flex items-center gap-2 justify-center sm:justify-start">
            <h1 class="my-2 text-2xl font-bold sm:my-4 sm:text-3xl"><span class="sr-only">@marcE</span><span class="typing-effect" aria-hidden="true">@marcE</span></h1>
            <a target="_blank" href="/rss.xml" class="inline-block" aria-label="rss feed" title="RSS Feed">
              <IconRss width={20} height={20} class="scale-125 stroke-accent stroke-3" />
              <span class="sr-only">RSS Feed</span>
            </a>
          </div>
          <div class="bio-collapsed space-y-3 opacity-80" id="bio-text">
            <p>Yoo!!! My name is Marc Ellington. You can call me Marc or BUG～.</p>
            <p>We creatures can be collectively called Vibe Coder ✌️, which can be understood as Silicon-Based Biological Nutritionist 👾.</p>
            <p>I don't like those tedious rules; I prefer to arrange what I want to do by myself and stay alone (I think this way is very efficient).</p>
            <p>They all say I'm bad at talking and a straight guy, and I think so too 😁. Whatever, I don't care about that. I often travel around and have been to many places (too many to count), but each place has great memories 🤠.</p>
            <p>Because my outfit is simple geek style, someone actually said I dress like a GAY. Me: "WTFREAK!? Isn't my outfit normal?! How am I a GAY 🤣" (I'm really not GAY, don't have this misunderstanding about me 🫥).</p>
            <p>Oh right! Most of the things I develop will be uploaded to GitHub for you to fork and remix ☝️.</p>
            <p>If I had to describe myself in one sentence, I think it would be: a sunny and cheerful guy哈哈哈 ✌️</p>
            <p>#SBTI:OJBK #MBTI:INTJ #"Loser" #Humorous #Good Guy #Marc #......</p>
          </div>
          <button id="read-more-btn" type="button" aria-expanded="false" aria-controls="bio-text" class="text-sm text-accent-text hover:underline mt-1">Read more</button>
          <div class="mt-4 flex flex-row items-center justify-center sm:justify-start">
            <div class="flex-wrap justify-center gap-1">
              <Socials />
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="max-w-3xl mx-auto px-4">
      <hr class="border-border" aria-hidden="true" />
    </div>

    <section id="recent" class="pt-12 pb-6">
      <div class="mb-4 flex items-center gap-5 border-b border-border pb-1" role="tablist" aria-label="Latest writing">
        <button
          type="button"
          class="feed-tab text-xl font-semibold tracking-wide"
          data-panel="blog"
          role="tab"
          id="tab-blog"
          aria-controls="panel-blog"
          aria-selected="true"
          tabindex="0"
        >
          Blog
        </button>
        <button
          type="button"
          class="feed-tab text-xl font-semibold tracking-wide"
          data-panel="research"
          role="tab"
          id="tab-research"
          aria-controls="panel-research"
          aria-selected="false"
          tabindex="-1"
        >
          Research
        </button>
      </div>

      <div id="panel-blog" role="tabpanel" aria-labelledby="tab-blog">
        <ul>
          {
            blogPosts.map(
              (data, index) =>
                index < SITE.postPerIndex && <Card variant="h3" {...data} />
            )
          }
        </ul>
        <div class="my-8 text-center">
          <LinkButton href="/posts/">
            All Posts
            <IconArrowRight class="inline-block rtl:-rotate-180" />
          </LinkButton>
        </div>
      </div>

      <div id="panel-research" role="tabpanel" aria-labelledby="tab-research" hidden>
        <ResearchFeed limit={4} showMore />
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .bio-collapsed {
    max-height: 7.5rem;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent);
    mask-image: linear-gradient(to bottom, #000 55%, transparent);
  }
  .typing-effect {
    display: inline-block;
    vertical-align: bottom;
    width: 6ch;
    overflow: hidden;
    white-space: nowrap;
    border-inline-end: 2px solid currentColor;
    animation:
      typing 2.5s steps(6) infinite alternate,
      caret 0.7s step-end infinite;
  }
  @keyframes typing {
    0%, 15% { width: 0; }
    60%, 100% { width: 6ch; }
  }
  @keyframes caret {
    50% { border-color: transparent; }
  }
  @media (prefers-reduced-motion: reduce) {
    .typing-effect {
      width: 6ch;
      animation: none;
      border-inline-end: none;
    }
  }

  /* Blog / Research tabs. The unselected one reads as a heading you can click rather than a
     button, so the row still looks like the section title it replaced. */
  .feed-tab {
    color: var(--foreground);
    opacity: 0.65;
    padding-bottom: 0.35rem;
    margin-bottom: -0.3rem;
    border-bottom: 2px solid transparent;
    transition: opacity 0.15s;
  }
  .feed-tab:hover {
    opacity: 0.85;
  }
  .feed-tab[aria-selected="true"] {
    opacity: 1;
    border-bottom-color: var(--accent);
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const bioText = document.getElementById("bio-text");
    const readMoreBtn = document.getElementById("read-more-btn");

    if (bioText && readMoreBtn) {
      readMoreBtn.addEventListener("click", () => {
        const isClamped = bioText.classList.contains("bio-collapsed");
        bioText.classList.toggle("bio-collapsed", !isClamped);
        readMoreBtn.textContent = isClamped ? "Show less" : "Read more";
        readMoreBtn.setAttribute("aria-expanded", String(isClamped));
      });
    }

    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }

    // Blog / Research tabs. Both panels are in the HTML, so the page is complete before this
    // runs and a reader with no JS sees the Blog list rather than nothing.
    const tabs = [...document.querySelectorAll<HTMLButtonElement>(".feed-tab")];
    const select = (tab: HTMLButtonElement) => {
      tabs.forEach(other => {
        const selected = other === tab;
        other.setAttribute("aria-selected", String(selected));
        other.tabIndex = selected ? 0 : -1;
        const panel = document.getElementById(`panel-${other.dataset.panel}`);
        if (panel) panel.hidden = !selected;
      });
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(tab));
      // Arrow keys move between tabs, as a tablist does everywhere else.
      tab.addEventListener("keydown", e => {
        const step = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
        if (!step) return;
        e.preventDefault();
        const next = tabs[(i + step + tabs.length) % tabs.length];
        select(next);
        next.focus();
      });
    });
  });
</script>