---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">
    <section id="hero" class="pt-6 pb-4">
      <div class="flex flex-col sm:flex-row items-start gap-4">
        <a href="/about" class="block mx-auto sm:mx-0 group">
          <img
            src="/marce.jpg"
            alt={SITE.author}
            class="w-40 h-40 rounded-full object-cover flex-shrink-0 transition-all duration-300 group-hover:scale-105 group-hover:shadow-xl"
          />
        </a>
        <div class="flex-1 text-center sm:text-left">
          <div class="flex items-center gap-2 justify-center sm:justify-start">
            <h1 class="my-2 inline-block text-2xl font-bold sm:my-4 sm:text-3xl typing-effect">
              <span class="typing-text">{SITE.author}</span>
              <span class="typing-cursor">|</span>
            </h1>
            <a target="_blank" href="/rss.xml" class="inline-block" aria-label="rss feed" title="RSS Feed">
              <IconRss width={20} height={20} class="scale-125 stroke-accent stroke-3" />
              <span class="sr-only">RSS Feed</span>
            </a>
          </div>
          <p class="opacity-80 line-clamp-5" id="bio-text">
            Yoo!!! My name is Mark Ellington. You can call me Marc or BUG～.<br/><br/>
            We creatures can be collectively called Vibe Coder ✌️, which can be understood as Silicon-Based Biological Nutritionist 👾.<br/><br/>
            I don't like those tedious rules; I prefer to arrange what I want to do by myself and stay alone (I think this way is very efficient).<br/><br/>
            They all say I'm bad at talking and a straight guy, and I think so too 😁. Whatever, I don't care about that. I often travel around and have been to many places (too many to count), but each place has great memories 🤠.<br/><br/>
            Because my outfit is simple geek style, someone actually said I dress like a GAY. Me: "WTFREAK!? Isn't my outfit normal?! How am I a GAY 🤣" (I'm really not GAY, don't have this misunderstanding about me 🫥).<br/><br/>
            Oh right! Most of the things I develop will be uploaded to GitHub for you to fork and remix ☝️.<br/><br/>
            If I had to describe myself in one sentence, I think it would be: a sunny and cheerful guy哈哈哈 ✌️<br/><br/>
            #SBTI:OJBK #MBTI:INTJ #"Loser" #Humorous #Good Guy #Marc #......
          </p>
          <button id="read-more-btn" class="text-sm text-accent hover:underline mt-1">Read more</button>
          <div class="mt-4 flex flex-row items-center justify-center sm:justify-start">
            <div class="flex-wrap justify-center gap-1">
              <Socials />
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="max-w-3xl mx-auto px-4">
      <hr class="border-border" aria-hidden="true" />
    </div>

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <ul>
            {recentPosts.map(
              (data, index) =>
                index < SITE.postPerIndex && <Card variant="h3" {...data} />
            )}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href="/posts/">
        All Posts
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .line-clamp-5 {
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .typing-cursor {
    animation: blink 1s infinite;
  }
  @keyframes blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const bioText = document.getElementById("bio-text");
    const readMoreBtn = document.getElementById("read-more-btn");

    if (bioText && readMoreBtn) {
      readMoreBtn.addEventListener("click", () => {
        const isClamped = bioText.classList.contains("line-clamp-5");
        bioText.classList.toggle("line-clamp-5", !isClamped);
        readMoreBtn.textContent = isClamped ? "Read more" : "Show less";
      });
    }

    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>