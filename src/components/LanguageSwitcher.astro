---
---

<span class="lang-switch flex items-center gap-1">
  <a
    href="/"
    class:list={[
      "lang-btn px-2 py-1 text-sm font-medium rounded transition-colors hover:text-accent",
      !Astro.url.pathname.startsWith("/zh") && "text-accent font-bold"
    ]}
    title="English"
  >
    EN
  </a>
  <span class="text-muted opacity-50">/</span>
  <a
    href="/zh"
    class:list={[
      "lang-btn px-2 py-1 text-sm font-medium rounded transition-colors hover:text-accent",
      Astro.url.pathname.startsWith("/zh") && "text-accent font-bold"
    ]}
    title="中文"
  >
    中文
  </a>
</span>

<style>
  .lang-btn {
    color: var(--foreground, #282728);
  }
  :global(.dark) .lang-btn {
    color: var(--foreground, #eaedf3);
  }
</style>