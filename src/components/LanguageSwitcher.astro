<span class="lang-switch flex items-center gap-1">
  <button
    id="lang-en"
    class="lang-btn px-2 py-1 text-sm font-medium rounded transition-colors hover:text-accent"
    title="English"
  >
    EN
  </button>
  <span class="text-muted opacity-50">/</span>
  <button
    id="lang-zh"
    class="lang-btn px-2 py-1 text-sm font-medium rounded transition-colors hover:text-accent"
    title="中文"
  >
    中文
  </button>
</span>

<script>
  function setActiveLang() {
    const enBtn = document.getElementById('lang-en');
    const zhBtn = document.getElementById('lang-zh');
    const path = window.location.pathname;

    if (path.startsWith('/zh')) {
      enBtn?.classList.add('text-accent', 'font-bold');
      zhBtn?.classList.remove('text-accent', 'font-bold');
    } else {
      zhBtn?.classList.add('text-accent', 'font-bold');
      enBtn?.classList.remove('text-accent', 'font-bold');
    }
  }

  enBtn?.addEventListener('click', () => {
    const path = window.location.pathname;
    if (path.startsWith('/zh')) {
      window.location.href = path.replace('/zh', '') || '/';
    }
  });

  zhBtn?.addEventListener('click', () => {
    const path = window.location.pathname;
    if (!path.startsWith('/zh')) {
      window.location.href = '/zh' + path;
    } else {
      window.location.href = path;
    }
  });

  setActiveLang();
  document.addEventListener('astro:after-swap', setActiveLang);
</script>