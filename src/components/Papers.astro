---
/**
 * The MØBIUS papers, in one of three densities.
 *
 * One component rather than three copies of the same list: the data and the status vocabulary are
 * the part that must not drift, and the only real difference between the places these appear is how
 * much room there is to explain each document.
 *
 * - `full`    — cards with the blurb and what has changed since. `/papers`, `/research`.
 * - `tiles`   — a three-up grid for the homepage, where the section has to be readable at a glance.
 * - `compact` — one line each, for the homepage's research tab, under the version log's own rows.
 */
import { papers } from "@/data/mobius/papers";
import { formatDay } from "@/utils/formatStamp";
import { getLangFromUrl } from "@/i18n/utils";

type Props = { variant?: "full" | "tiles" | "compact" };
const { variant = "full" } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = {
  en: { pages: "pages", since: "Since then" },
  zh: { pages: "页", since: "此后" },
}[lang];
---

{
  variant === "full" && (
    <ul class="flex flex-col gap-3">
      {papers.map(paper => (
        <li class="paper-card">
          <a href={paper.href} class="paper-head">
            <span class="paper-title">{paper.title}</span>
            {paper.subtitle && <span class="paper-sub">{paper.subtitle}</span>}
          </a>
          <p class="paper-meta">
            <span class={`st st-${paper.kind}`}>{paper.status}</span>
            <span>
              PDF · {paper.pages} {t.pages} · {formatDay(paper.at, lang)}
            </span>
          </p>
          <p class="paper-blurb">
            {lang === "zh" ? paper.blurbZh : paper.blurb}
          </p>
          {paper.since && (
            <p class="paper-since">
              <strong>{t.since}:</strong>{" "}
              {lang === "zh" ? paper.sinceZh : paper.since}
            </p>
          )}
        </li>
      ))}
    </ul>
  )
}

{
  variant === "tiles" && (
    <ul class="grid gap-4 sm:grid-cols-3">
      {papers.map(paper => (
        <li>
          <a href={paper.href} class="paper-tile">
            <span class="tile-kind">PDF</span>
            <span class="tile-title">{paper.title}</span>
            {paper.subtitle && <span class="tile-sub">{paper.subtitle}</span>}
            <span class="tile-foot">
              <span class={`st st-${paper.kind}`}>{paper.status}</span>
              <span class="tile-meta">
                {paper.pages} {t.pages} · {formatDay(paper.at, lang)}
              </span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  )
}

{
  variant === "compact" && (
    <ul class="flex flex-col">
      {papers.map(paper => (
        <li class="row grid gap-x-5 border-t border-border py-2.5">
          <span class="v opacity-60">PDF</span>
          <div>
            <time class="stamp block opacity-55" datetime={paper.at}>
              {formatDay(paper.at, lang)}
            </time>
            <a
              href={paper.href}
              class="text-[0.95rem] leading-snug text-accent underline decoration-dashed underline-offset-4 hover:decoration-solid"
            >
              {paper.title}
            </a>
            <span class={`st st-${paper.kind} ms-2`}>{paper.status}</span>
          </div>
        </li>
      ))}
    </ul>
  )
}

<style>
  /* full */
  .paper-card {
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 0.95rem 1.1rem;
    background: color-mix(in srgb, var(--muted) 38%, transparent);
  }
  .paper-card:hover {
    border-color: var(--accent);
  }
  .paper-head {
    display: block;
    text-decoration: none;
  }
  .paper-title {
    display: block;
    font-size: 1rem;
    font-weight: 700;
    color: var(--accent);
  }
  .paper-sub {
    display: block;
    font-size: 0.82rem;
    opacity: 0.72;
    margin-top: 0.1rem;
  }
  .paper-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.72rem;
    opacity: 0.7;
    margin: 0.55rem 0 0.5rem;
  }
  .paper-blurb {
    font-size: 0.875rem;
    line-height: 1.6;
    opacity: 0.88;
  }
  .paper-since {
    font-size: 0.78rem;
    line-height: 1.55;
    opacity: 0.68;
    margin-top: 0.45rem;
  }

  /* tiles */
  .paper-tile {
    display: flex;
    flex-direction: column;
    height: 100%;
    gap: 0.3rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 0.9rem 1rem 1rem;
    text-decoration: none;
    background: color-mix(in srgb, var(--muted) 38%, transparent);
    transition: border-color 0.2s ease;
  }
  .paper-tile:hover {
    border-color: var(--accent);
  }
  .tile-kind {
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    opacity: 0.55;
  }
  .tile-title {
    font-size: 0.98rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--accent);
  }
  .tile-sub {
    font-size: 0.78rem;
    line-height: 1.45;
    opacity: 0.72;
  }
  .tile-foot {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-top: auto;
    padding-top: 0.6rem;
  }
  .tile-meta {
    font-size: 0.7rem;
    opacity: 0.6;
  }

  /* compact — matches the version rows it sits beside */
  .row {
    grid-template-columns: 4.5rem 1fr;
    align-items: baseline;
  }
  .v {
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
  }
  .stamp {
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.03em;
    margin-bottom: 0.2rem;
  }
  @media (max-width: 30rem) {
    .row {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }
</style>
