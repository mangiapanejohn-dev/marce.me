---
import IconX from "@/assets/icons/IconX.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconArchive from "@/assets/icons/IconArchive.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import LinkButton from "./LinkButton.astro";
import LanguagePicker from "./LanguagePicker.astro";
import { SITE } from "@/config";
import { getLangFromUrl, useTranslations, localizePath } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { pathname } = Astro.url;

// Remove trailing slash from current pathname if exists
const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

// Compare against English-rooted paths regardless of the active locale.
const basePath =
  lang === "zh" ? currentPath.replace(/^\/zh/, "") || "/" : currentPath;

const isActive = (path: string) => {
  const currentPathArray = basePath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());

  return basePath === path || currentPathArray[0] === pathArray[0];
};

const l = (path: string) => localizePath(path, lang);
---

<a
  id="skip-to-content"
  href="#main-content"
  class="absolute start-16 -top-full z-50 bg-background px-3 py-2 text-accent-text backdrop-blur-lg transition-all focus:top-4"
>
  {t("skip")}
</a>

<header
  class="app-layout flex flex-col items-center justify-between sm:flex-row"
>
  <div
    id="top-nav-wrap"
    class:list={[
      "py-4 sm:py-6",
      "border-b border-border",
      "relative w-full bg-background",
      "flex items-baseline justify-between sm:items-center",
    ]}
  >
    <a
      href={l("/")}
      class="absolute py-1 text-xl leading-8 font-semibold whitespace-nowrap sm:static sm:my-auto sm:text-2xl sm:leading-none"
    >
      {SITE.title}
    </a>
    <nav
      id="nav-menu"
      class="flex w-full flex-col items-center sm:ms-2 sm:flex-row sm:justify-end sm:space-x-4 sm:py-0"
    >
      <button
        id="menu-btn"
        class="focus-outline self-end p-2 sm:hidden"
        aria-label={t("menu.open")}
        aria-expanded="false"
        aria-controls="menu-items"
      >
        <IconX id="close-icon" class="hidden" />
        <IconMenuDeep id="menu-icon" />
      </button>
      <ul
        id="menu-items"
        class:list={[
          "mt-4 grid w-44 grid-cols-2 place-content-center gap-2",
          "[&>li>a]:block [&>li>a]:px-4 [&>li>a]:py-3 [&>li>a]:text-center [&>li>a]:font-medium [&>li>a]:whitespace-nowrap [&>li>a]:hover:text-accent-text sm:[&>li>a]:px-2 sm:[&>li>a]:py-1",
          "hidden",
          "sm:mt-0 sm:flex sm:w-auto sm:gap-x-5 sm:gap-y-0",
        ]}
      >
        <li class="col-span-2">
          <a
            href={l("/posts")}
            class:list={["nav-link", { "active-nav": isActive("/posts") }]}
          >
            {t("nav.posts")}
          </a>
        </li>
        <li class="nav-group col-span-2">
          <a
            href={l("/research")}
            class:list={[
              "nav-link",
              { "active-nav": isActive("/research") || isActive("/papers") },
            ]}
            aria-haspopup="true"
          >
            {t("nav.research")}
            <span class="caret" aria-hidden="true">▾</span>
          </a>
          <ul class="submenu">
            <li>
              <a
                href={l("/research")}
                class:list={[
                  "sub-link",
                  { "sub-active": isActive("/research") },
                ]}
              >
                {t("nav.researchLog")}
              </a>
            </li>
            <li>
              <a
                href={l("/papers")}
                class:list={["sub-link", { "sub-active": isActive("/papers") }]}
              >
                {t("nav.papers")}
              </a>
            </li>
          </ul>
        </li>
        <li class="col-span-2">
          <a
            href={l("/tags")}
            class:list={["nav-link", { "active-nav": isActive("/tags") }]}
          >
            {t("nav.tags")}
          </a>
        </li>
        <li class="col-span-2">
          <a
            href={l("/about")}
            class:list={["nav-link", { "active-nav": isActive("/about") }]}
          >
            {t("nav.about")}
          </a>
        </li>
        {
          SITE.showArchives && (
            <li class="col-span-2">
              <LinkButton
                href={l("/archives")}
                class:list={[
                  "focus-outline flex justify-center p-3 sm:p-1",
                  {
                    "active-nav [&>svg]:stroke-accent": isActive("/archives"),
                  },
                ]}
                title={t("nav.archives")}
                aria-label={t("nav.archives")}
              >
                <IconArchive class="hidden sm:inline-block" />
                <span class="sm:sr-only">{t("nav.archives")}</span>
              </LinkButton>
            </li>
          )
        }
        <li class="col-span-1 flex items-center justify-center">
          <LinkButton
            href={l("/search")}
            class:list={[
              "focus-outline flex p-3 sm:p-1",
              { "[&>svg]:stroke-accent": isActive("/search") },
            ]}
            title={t("nav.search")}
            aria-label={t("nav.search")}
          >
            <IconSearch />
            <span class="sr-only">{t("nav.search")}</span>
          </LinkButton>
        </li>
        {
          SITE.lightAndDarkMode && (
            <li class="col-span-1 flex items-center justify-center">
              <button
                id="theme-btn"
                class="focus-outline relative size-12 p-4 sm:size-8 hover:[&>svg]:stroke-accent"
                title="Toggles light & dark"
                aria-label="auto"
                aria-live="polite"
              >
                <IconMoon class="absolute top-[50%] left-[50%] -translate-[50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
                <IconSunHigh class="absolute top-[50%] left-[50%] -translate-[50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
              </button>
            </li>
          )
        }
        <li class="col-span-1 flex items-center justify-center">
          <LanguagePicker />
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  /* The hover underline: it grows from the middle rather than appearing all at once, which is the
     difference between a link reacting and a link just changing colour. `.active-nav` keeps the
     wavy underline that marks the current section, so the two never draw at the same time. */
  .nav-link {
    position: relative;
  }
  .nav-link::after {
    content: "";
    position: absolute;
    inset-inline: 50%;
    bottom: 0.15rem;
    height: 1.5px;
    border-radius: 1px;
    background: currentColor;
    opacity: 0;
    transition:
      inset-inline 0.28s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.2s ease;
  }
  .nav-link:hover::after,
  .nav-link:focus-visible::after {
    inset-inline: 0.5rem;
    opacity: 0.85;
  }
  .active-nav::after {
    content: none;
  }
  .caret {
    display: none;
    font-size: 0.6em;
    opacity: 0.55;
    margin-inline-start: 0.25rem;
    transition: transform 0.2s ease;
  }
  .sub-link {
    display: block;
    white-space: nowrap;
    border-radius: 7px;
    padding: 0.45rem 0.7rem;
    font-size: 0.9rem;
    transition:
      background 0.18s ease,
      color 0.18s ease;
  }
  .sub-link:hover {
    color: var(--accent-text);
    background: color-mix(in srgb, var(--muted) 70%, transparent);
  }
  .sub-active {
    color: var(--accent-text);
  }

  @media (min-width: 640px) {
    .nav-group {
      position: relative;
      padding-bottom: 0.35rem;
      margin-bottom: -0.35rem;
    }
    .caret {
      display: inline-block;
    }
    .submenu {
      position: absolute;
      top: 100%;
      inset-inline-start: 50%;
      z-index: 50;
      min-width: 10.5rem;
      padding: 0.35rem;
      border: 1px solid var(--border);
      border-radius: 10px;
      background: var(--background);
      box-shadow: 0 10px 28px rgb(0 0 0 / 12%);
      opacity: 0;
      visibility: hidden;
      transform: translate(-50%, -0.35rem);
      transition:
        opacity 0.18s ease,
        transform 0.18s ease,
        visibility 0.18s;
    }
    .nav-group:hover .submenu,
    .nav-group:focus-within .submenu {
      opacity: 1;
      visibility: visible;
      transform: translate(-50%, 0.15rem);
    }
    .nav-group:hover .caret,
    .nav-group:focus-within .caret {
      transform: rotate(180deg);
    }
  }

  /* On the phone menu there is no hover, so the sub-item is simply always there, one step in. */
  @media (max-width: 639px) {
    .submenu {
      display: flex;
      flex-direction: column;
      align-items: center;
      margin-bottom: 0.4rem;
    }
    .sub-link {
      opacity: 0.8;
      font-size: 0.85rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link::after,
    .submenu,
    .caret {
      transition: none;
    }
  }
</style>

<script>
  function toggleNav() {
    const menuBtn = document.querySelector("#menu-btn");
    const menuItems = document.querySelector("#menu-items");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");

    if (!menuBtn || !menuItems || !menuIcon || !closeIcon) return;

    menuBtn.addEventListener("click", () => {
      const openMenu = menuBtn.getAttribute("aria-expanded") === "true";

      menuBtn.setAttribute("aria-expanded", openMenu ? "false" : "true");
      menuBtn.setAttribute("aria-label", openMenu ? "Open Menu" : "Close Menu");

      menuItems.classList.toggle("hidden");
      menuIcon.classList.toggle("hidden");
      closeIcon.classList.toggle("hidden");
    });
  }

  toggleNav();

  // Runs on view transitions navigation
  document.addEventListener("astro:after-swap", toggleNav);
</script>
