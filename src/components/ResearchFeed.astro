---
import { getCollection } from "astro:content";
import { versions, essays } from "@/data/mobius/versions";
import { papers } from "@/data/mobius/papers";
import { formatStamp, formatDay } from "@/utils/formatStamp";
import { getLangFromUrl, localizePath } from "@/i18n/utils";

type Props = {
  /** How many version rows to show. Omit for all of them. */
  limit?: number;
  /** Link through to the full feed at the bottom. Off on the feed page itself. */
  showMore?: boolean;
  /**
   * Papers as full cards with their blurb and their standing, rather than one line each.
   *
   * On the feed page there is room to say what a document argues and where it stands now; on the
   * homepage tab there is not, and a wall of abstracts would bury the version log underneath it.
   */
  fullPapers?: boolean;
};

const { limit, showMore = false, fullPapers = false } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const l = (path: string) => localizePath(path, lang);

// Newest first. The array is authored oldest-first because that is how the work happened, and a
// feed reads the other way — reversed here rather than in the data, so /mobius keeps reading
// forwards from ADR 0013.
const rows = [...versions].reverse().slice(0, limit ?? versions.length);

// Titles come from the collection so they cannot drift from the posts themselves; only the span
// label comes from the essay map.
const posts = await getCollection("blog", ({ data }) => data.lang !== "zh");
const essayRows = essays.flatMap(essay => {
  const post = posts.find(p => p.id === essay.slug);
  return post
    ? [
        {
          ...essay,
          title: post.data.title,
          at: post.data.pubDatetime.toISOString(),
        },
      ]
    : [];
});

// An essay written after the newest version row is the latest thing in the research, so it leads the
// feed instead of waiting under the version rows; older essays stay in their section below.
const newestVersion = Math.max(...versions.map(({ at }) => new Date(at).getTime()));
const latestEssays = essayRows
  .filter(({ at }) => new Date(at).getTime() > newestVersion)
  .sort((a, b) => b.at.localeCompare(a.at));
const olderEssays = essayRows.filter(essay => !latestEssays.includes(essay));

const t = {
  en: {
    versions: "Versions",
    essays: "Essays",
    more: "The full log",
    latest: "Latest",
    papers: "Papers & formal notes",
    pages: "pages",
    since: "Since then",
  },
  zh: {
    versions: "版本",
    essays: "文章",
    more: "完整日志",
    latest: "最新",
    papers: "论文与形式化笔记",
    pages: "页",
    since: "此后",
  },
}[lang];
---

<div class="research-feed">
  {
    latestEssays.length > 0 && (
      <div class="mb-6">
        <p class="mb-2 text-[0.7rem] tracking-[0.13em] uppercase opacity-60">
          {t.latest}
        </p>
        <ul class="flex flex-col">
          {latestEssays.map(({ slug, span, spanZh, title, at }) => (
            <li class="row grid gap-x-5 border-t border-border py-3.5">
              <span class="v opacity-60">{lang === "zh" ? spanZh : span}</span>
              <div>
                <time class="stamp block opacity-55" datetime={at}>
                  {formatDay(at, lang)}
                </time>
                <a
                  href={l(`/posts/${slug}/`)}
                  class="text-[1.05rem] leading-snug font-semibold text-accent underline decoration-dashed underline-offset-4 hover:decoration-solid"
                >
                  {title}
                </a>
              </div>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  {
    papers.length > 0 && (
      <div class="mb-7">
        <p class="mb-2 text-[0.7rem] tracking-[0.13em] uppercase opacity-60">
          {t.papers}
        </p>
        {fullPapers ? (
          <ul class="flex flex-col gap-3">
            {papers.map(paper => (
              <li class="paper-card">
                <a href={paper.href} class="paper-head">
                  <span class="paper-title">{paper.title}</span>
                  {paper.subtitle && <span class="paper-sub">{paper.subtitle}</span>}
                </a>
                <p class="paper-meta">
                  <span class={`st st-${paper.kind}`}>{paper.status}</span>
                  <span>
                    PDF · {paper.pages} {t.pages} · {formatDay(paper.at, lang)}
                  </span>
                </p>
                <p class="paper-blurb">{lang === "zh" ? paper.blurbZh : paper.blurb}</p>
                {paper.since && (
                  <p class="paper-since">
                    <strong>{t.since}:</strong>{" "}
                    {lang === "zh" ? paper.sinceZh : paper.since}
                  </p>
                )}
              </li>
            ))}
          </ul>
        ) : (
          <ul class="flex flex-col">
            {papers.map(paper => (
              <li class="row grid gap-x-5 border-t border-border py-2.5">
                <span class="v opacity-60">PDF</span>
                <div>
                  <time class="stamp block opacity-55" datetime={paper.at}>
                    {formatDay(paper.at, lang)}
                  </time>
                  <a
                    href={paper.href}
                    class="text-[0.95rem] leading-snug text-accent underline decoration-dashed underline-offset-4 hover:decoration-solid"
                  >
                    {paper.title}
                  </a>
                  <span class={`st st-${paper.kind} ms-2`}>{paper.status}</span>
                </div>
              </li>
            ))}
          </ul>
        )}
      </div>
    )
  }

  <ul class="flex flex-col">
    {
      rows.map(({ v, at, claim, claimZh, blurb, blurbZh, post }) => (
        <li class="row grid gap-x-5 border-t border-border py-3.5">
          <span class="v opacity-60">{v}</span>
          <div>
            <time class="stamp block opacity-55" datetime={at}>
              {formatStamp(at, lang)}
            </time>
            <h3 class="text-[0.95rem] leading-snug font-semibold">
              {post ? (
                <a
                  href={l(`/posts/${post}/`)}
                  class="text-accent underline decoration-dashed underline-offset-4 hover:decoration-solid"
                >
                  {lang === "zh" ? claimZh : claim}
                </a>
              ) : (
                (lang === "zh" ? claimZh : claim)
              )}
            </h3>
            <p class="mt-1 text-[0.875rem] leading-relaxed opacity-70">
              {lang === "zh" ? blurbZh : blurb}
            </p>
          </div>
        </li>
      ))
    }
  </ul>

  {
    olderEssays.length > 0 && (
      <div class="mt-7 border-t-2 border-dashed border-border pt-4">
        <p class="mb-2 text-[0.7rem] tracking-[0.13em] uppercase opacity-60">
          {t.essays}
        </p>
        <ul class="flex flex-col">
          {olderEssays.map(({ slug, span, spanZh, title, at }) => (
            <li class="row grid gap-x-5 border-t border-border py-2.5">
              <span class="v opacity-60">{lang === "zh" ? spanZh : span}</span>
              <div>
                <time class="stamp block opacity-55" datetime={at}>
                  {formatDay(at, lang)}
                </time>
                <a
                  href={l(`/posts/${slug}/`)}
                  class="text-[0.95rem] leading-snug text-accent underline decoration-dashed underline-offset-4 hover:decoration-solid"
                >
                  {title}
                </a>
              </div>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  {
    showMore && (
      <p class="mt-6 text-sm">
        <a
          href={l("/research/")}
          class="text-accent underline decoration-dashed underline-offset-4 hover:decoration-solid"
        >
          {t.more} →
        </a>
      </p>
    )
  }
</div>

<style>
  .paper-card {
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 0.95rem 1.1rem;
    background: color-mix(in srgb, var(--muted) 38%, transparent);
  }
  .paper-card:hover {
    border-color: var(--accent);
  }
  .paper-head {
    display: block;
    text-decoration: none;
  }
  .paper-title {
    display: block;
    font-size: 1rem;
    font-weight: 700;
    color: var(--accent);
  }
  .paper-sub {
    display: block;
    font-size: 0.82rem;
    opacity: 0.72;
    margin-top: 0.1rem;
  }
  .paper-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.72rem;
    opacity: 0.7;
    margin: 0.55rem 0 0.5rem;
  }
  .paper-blurb {
    font-size: 0.875rem;
    line-height: 1.6;
    opacity: 0.88;
  }
  .paper-since {
    font-size: 0.78rem;
    line-height: 1.55;
    opacity: 0.68;
    margin-top: 0.45rem;
  }
  .row {
    grid-template-columns: 4.5rem 1fr;
    align-items: baseline;
  }
  .v {
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
  }
  .stamp {
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.03em;
    margin-bottom: 0.2rem;
  }
  @media (max-width: 30rem) {
    .row {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }
</style>
