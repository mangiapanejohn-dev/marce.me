---
import type { MarkdownHeading } from "astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

type Props = {
  headings: MarkdownHeading[];
};

const { headings } = Astro.props;

// Section headings on this site carry their number in the text ("2 · Completion judgement"). The
// number gets its own column so a title that wraps lines up under itself, not under the number.
const items = headings.map(h => {
  const m = h.text.match(/^(\S{1,4})\s+·\s+(.+)$/);
  return { slug: h.slug, num: m?.[1] ?? "", title: m?.[2] ?? h.text };
});

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!--
  Two renderings of one list. Below 1280px there is no room beside the column, so the contents sit
  under the title, folded. From 1280px the list moves into the margin to the left of the column and
  follows the reader down, marking the section they are in. The prose column does not move.
-->
<details class="toc-inline xl:hidden">
  <summary>{t("post.toc")}</summary>
  <ol>
    {
      items.map(h => (
        <li>
          <a href={`#${h.slug}`}>
            {h.num && <span class="toc-num">{h.num}</span>}
            <span class="toc-title">{h.title}</span>
          </a>
        </li>
      ))
    }
  </ol>
</details>

<aside class="toc-side hidden xl:block" aria-label={t("post.toc")}>
  <nav>
    <p class="toc-label">{t("post.toc")}</p>
    <ol>
      {
        items.map(h => (
          <li>
            <a href={`#${h.slug}`} data-toc-link={h.slug}>
              {h.num && <span class="toc-num">{h.num}</span>}
              <span class="toc-title">{h.title}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
</aside>

<style>
  /* Shared by both renderings: number column, title beside it, and between entries a short tick
     that starts where the titles start — enough to separate, not a rule across the column. */
  li + li::before {
    content: "";
    display: block;
    width: 1.25rem;
    height: 1px;
    margin-inline-start: 1.75rem;
    background: color-mix(in srgb, var(--foreground) 18%, transparent);
  }
  li a {
    display: grid;
    grid-template-columns: 1.4rem 1fr;
    column-gap: 0.35rem;
    padding-block: 0.45rem;
  }
  .toc-num {
    font-variant-numeric: tabular-nums;
    opacity: 0.55;
  }
  .toc-title {
    grid-column: 2;
    text-wrap: pretty;
  }

  .toc-inline {
    margin-top: 1.5rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.6rem 0.75rem;
    font-size: 0.875rem;
  }
  .toc-inline summary {
    cursor: pointer;
    font-weight: 600;
  }
  .toc-inline ol {
    margin-top: 0.4rem;
  }
  .toc-inline a:hover {
    color: var(--accent-text);
  }

  /* The aside spans the article's full height so the nav inside can stick for all of it. */
  .toc-side {
    position: absolute;
    top: 0;
    bottom: 0;
    inset-inline-end: calc(100% + 2.5rem);
    width: 13rem;
  }
  .toc-side nav {
    position: sticky;
    top: 2rem;
    max-height: calc(100svh - 4rem);
    overflow-y: auto;
    font-size: 0.78rem;
    line-height: 1.45;
  }
  .toc-label {
    margin-bottom: 0.25rem;
    font-weight: 600;
    opacity: 0.7;
  }
  .toc-side a {
    opacity: 0.7;
    transition:
      opacity 0.15s ease,
      color 0.15s ease;
  }
  .toc-side a:hover {
    opacity: 1;
  }
  /* The section being read: full ink in the accent, the number picked out. */
  .toc-side a[aria-current="true"] {
    opacity: 1;
    color: var(--accent-text);
  }
  .toc-side a[aria-current="true"] .toc-num {
    opacity: 1;
    font-weight: 600;
  }
  @media (prefers-reduced-motion: reduce) {
    .toc-side a {
      transition: none;
    }
  }
</style>

<script>
  let controller: AbortController | undefined;

  // The current section is the last heading that has scrolled past the top quarter of the screen.
  function trackCurrentSection() {
    controller?.abort();
    const links = [
      ...document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"),
    ];
    if (!links.length) return;
    controller = new AbortController();

    const targets = links
      .map(link => document.getElementById(link.dataset.tocLink ?? ""))
      .filter((el): el is HTMLElement => el !== null);

    let frame = 0;
    const update = () => {
      frame = 0;
      const line = window.innerHeight * 0.25;
      let current = -1;
      targets.forEach((el, i) => {
        if (el.getBoundingClientRect().top <= line) current = i;
      });
      links.forEach((link, i) => {
        if (i === current) link.setAttribute("aria-current", "true");
        else link.removeAttribute("aria-current");
      });
    };
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    window.addEventListener("scroll", schedule, {
      passive: true,
      signal: controller.signal,
    });
    window.addEventListener("resize", schedule, { signal: controller.signal });
    update();
  }

  document.addEventListener("astro:page-load", trackCurrentSection);
  document.addEventListener("astro:before-swap", () => controller?.abort());
</script>
