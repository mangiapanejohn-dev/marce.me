---
import IconArchive from "@/assets/icons/IconArchive.svg";
import { categoryName, type CategorySlug } from "@/data/categories";
import { getLangFromUrl, localizePath } from "@/i18n/utils";

type Props = {
  category: CategorySlug;
  count?: number;
  size?: "sm" | "lg";
};

const { category, count, size = "lg" } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const href = localizePath(`/categories/${category}/`, lang);
---

<li>
  <a
    href={href}
    transition:name={`category-${category}`}
    class:list={[
      "flex items-center gap-1",
      "border-b-2 border-dashed border-foreground",
      "hover:-mt-0.5 hover:border-accent hover:text-accent",
      "focus-visible:border-none focus-visible:text-accent",
      { "text-sm": size === "sm" },
      { "text-lg": size === "lg" },
    ]}
  >
    <IconArchive
      class:list={[
        "opacity-80",
        { "size-5": size === "lg" },
        { "size-4": size === "sm" },
      ]}
    />
    {categoryName(category, lang)}
    {count !== undefined && <span class="opacity-60">({count})</span>}
  </a>
</li>
