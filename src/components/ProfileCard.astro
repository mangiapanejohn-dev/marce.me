---
import { SOCIALS } from "@/constants";

interface Props {
  lang?: "en" | "zh";
}
const { lang = "en" }: Props = Astro.props;

const copy =
  lang === "zh"
    ? {
        role: "Vibe Coder",
        tagline: "做真的记得住你的 AI 工具。",
        meta: ["长沙", "CTO @ Horizon-Ai"],
        foot: "每个 commit 都会上 GitHub，随便你 fork",
      }
    : {
        role: "Vibe Coder",
        tagline: "Building AI tools that actually remember you.",
        meta: ["ChengDu", "CTO @ Horizon-Ai"],
        foot: "Every commit lands on GitHub — fork & remix",
      };
---

<article class="pcard">
  <div class="pcard-inner">
    <picture class="avatar">
      <source srcset="/marce-card-avatar.webp" type="image/webp" />
      <img
        src="/marce-card-avatar.png"
        width="320"
        height="320"
        alt="Marc Ellington"
        fetchpriority="high"
      />
    </picture>

    <div class="info">
      <p class="role">{copy.role}</p>
      <h1 class="name">Marc Ellington</h1>
      <p class="handle">@marcE</p>
      <p class="tagline">{copy.tagline}</p>

      <ul class="meta">
        {copy.meta.map(m => <li>{m}</li>)}
      </ul>

      <div class="socials">
        {
          SOCIALS.map(social => (
            <a href={social.href} title={social.linkTitle} target="_blank" rel="me noopener">
              <social.icon class="icon" />
              <span class="sr-only">{social.name}</span>
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <p class="foot">{copy.foot}</p>
</article>

<style>
  /* Proportion is locked to an iPhone 17 (402 x 874pt): full width, quarter
     height -> 402 x 218.5. Every inner dimension is expressed in cqw (1cqw = 1%
     of the card's own width), so the whole card scales as one piece on narrow
     screens and the ratio never drifts. */
  .pcard {
    --line: color-mix(in srgb, var(--foreground) 20%, transparent);
    --faint: color-mix(in srgb, var(--foreground) 55%, transparent);

    container-type: inline-size;
    width: 402px;
    max-width: 100%;
    aspect-ratio: 402 / 218.5;

    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: 3.4cqw;
    background: color-mix(in srgb, var(--accent) 4%, var(--background));
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.04),
      0 4cqw 11cqw -5cqw rgba(0, 0, 0, 0.35);
    overflow: hidden;
    font-variant-ligatures: none;
  }
  :global(html[data-theme="dark"]) .pcard {
    border-color: color-mix(in srgb, var(--foreground) 14%, transparent);
    box-shadow: 0 6cqw 16cqw -6cqw rgba(0, 0, 0, 0.7);
  }

  /* avatar left, info right */
  .pcard-inner {
    flex: 1;
    min-height: 0;
    display: flex;
    align-items: center;
    gap: 3.6cqw;
    padding: 0 4cqw;
  }

  .avatar {
    flex-shrink: 0;
    display: block;
  }
  .avatar img {
    display: block;
    width: 22cqw;
    height: 22cqw;
    border-radius: 2.6cqw;
    object-fit: cover;
    border: 1px solid var(--line);
  }

  .info {
    min-width: 0;
    flex: 1;
  }
  .role {
    font-size: 2.24cqw;
    line-height: 1.2;
    letter-spacing: 0.42cqw;
    text-transform: uppercase;
    color: var(--accent);
  }
  .name {
    margin-top: 0.7cqw;
    font-size: 4.1cqw;
    line-height: 1.15;
    font-weight: 700;
  }
  .handle {
    margin-top: 0.2cqw;
    font-size: 2.6cqw;
    line-height: 1.3;
    color: var(--faint);
  }
  .tagline {
    margin-top: 1.4cqw;
    font-size: 2.7cqw;
    line-height: 1.5;
    color: color-mix(in srgb, var(--foreground) 88%, transparent);
    text-wrap: pretty;
  }

  .meta {
    list-style: none;
    padding: 0;
    margin-top: 1.4cqw;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.2cqw;
    font-size: 2.4cqw;
    line-height: 1.3;
    color: var(--faint);
  }
  /* dot separator between meta items, never a trailing one */
  .meta li + li::before {
    content: "·";
    margin-right: 1.2cqw;
    color: var(--accent);
  }

  .socials {
    margin-top: 1.7cqw;
    display: flex;
    align-items: center;
    gap: 0.3cqw;
    margin-left: -0.8cqw;
  }
  .socials a {
    padding: 0.8cqw;
    border-radius: 1cqw;
    /* deliberately stronger than --faint: at 55% the stroked icons read as
       disabled rather than secondary */
    color: color-mix(in srgb, var(--foreground) 70%, transparent);
    line-height: 0;
    transition:
      color 0.15s ease,
      background 0.15s ease,
      transform 0.15s ease;
  }
  .socials a:hover {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    transform: translateY(-1px);
  }
  .socials :global(.icon) {
    width: 3.5cqw;
    height: 3.5cqw;
    fill: transparent;
    stroke: currentColor;
    stroke-width: 2;
  }

  .foot {
    flex-shrink: 0;
    padding: 1.7cqw 4cqw;
    border-top: 1px solid var(--line);
    background: color-mix(in srgb, var(--muted) 18%, transparent);
    font-size: 2.2cqw;
    line-height: 1.3;
    letter-spacing: 0.06cqw;
    color: var(--faint);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (prefers-reduced-motion: reduce) {
    .socials a {
      transition: none;
    }
    .socials a:hover {
      transform: none;
    }
  }
</style>
