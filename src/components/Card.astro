---
import type { CollectionEntry } from "astro:content";
import { slugifyStr } from "@/utils/slugify";
import { getPath } from "@/utils/getPath";
import { getLangFromUrl, localizePath } from "@/i18n/utils";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"blog">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;

const { title, description, cover, ...props } = data;

const lang = getLangFromUrl(Astro.url);
const href = localizePath(getPath(id, filePath), lang);
---

<li class="my-6 flex flex-col gap-4 sm:flex-row">
  {
    cover && (
      <a
        href={href}
        tabindex="-1"
        aria-hidden="true"
        class="group block overflow-hidden rounded-lg border border-border sm:w-52 sm:flex-shrink-0 sm:self-start"
      >
        <img
          src={cover}
          alt=""
          loading="lazy"
          class="h-44 w-full object-cover transition-transform duration-300 group-hover:scale-105 sm:h-32"
        />
      </a>
    )
  }
  <div class="flex-1">
    <a
      href={href}
      class:list={[
        "inline-block text-lg font-medium text-accent",
        "decoration-dashed underline-offset-4 hover:underline",
        "focus-visible:no-underline focus-visible:underline-offset-0",
      ]}
    >
      <Heading
        style={{ viewTransitionName: slugifyStr(title.replaceAll(".", "-")) }}
      >
        {title}
      </Heading>
    </a>
    <Datetime {...props} />
    <p>{description}</p>
  </div>
</li>
